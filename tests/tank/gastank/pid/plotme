#Plot variables with gnuplot
data="work/plant_res.csv"
set datafile separator ","
xlabel = "time (s)"

set term qt

set grid
set multiplot layout 4,1

set nokey
set ylabel  "Tank T(C)"
plot data using (column("time")):(column("tank.T")-273) w l  lw 2

set key
set ylabel ""
plot data using (column("time")):(column("pid.sp")*1e-5) w l lw 2 title "sp", \
     data using (column("time")):(column("pid.pv")*1e-5) w l lw 2 title "pv"

set nokey
set ylabel  "Valve (%)"
plot data using (column("time")):(column("valve.po")) w l  lw 2

set key
set ylabel "lpm(s)"
plot data using (column("time")):(-column("tank.outlet.m_flow")*60e3) w l lw 2 title "outflow", \
     data using (column("time")):(column("tank.inlet.m_flow")*60e3) w l lw 2 title "inflow"
unset multiplot
pause(-1)

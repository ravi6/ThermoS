
// mos script
cd ("./work");

// myScript.mos
setCommandLineOptions("+d=initialization +d=tearing +d=omc +d=dae +d=simulation");

// Load standard libraries first
loadModel(Modelica);

// Load your additional libraries
loadFile("/home/ThermoS/package.mo");

// Load your plant model
loadFile("../plant.mo");

// Check model instantiation
instantiateModel(plant); // <-- This will fail loudly with all error details
simulate(plant,
    startTime=0.0,
    stopTime=10.0,
    numberOfIntervals=500,
    tolerance=1e-6,
    method="dassl",
    fileNamePrefix="plant",
    outputFormat="mat",
    variableFilter=".*",
    simflags="-d=initialization,-d=tearing,-d=omc,-d=codegen"
);


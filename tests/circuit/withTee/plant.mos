/*  A simple script Template to run my Plant Model
          Author: Ravi Saripalli
	  Date:   23th Jul. 2015
          Modified: 24 Sep. 2024 
*/  
// ==================== SETTINGS ====================
echo(false);
tEnd := 150;  // simulation stop time
logFile := "log";
resFormat := "mat" ;
resFile := "plant_res." + resFormat ;

// Force C backend and useful debug
setCommandLineOptions("--simCodeTarget=C");
setDebugFlags("infoXmlOperations");
setDebugFlags("aliasConflicts");

// Ensure clean working directory
system("mkdir -p ./work"); cd("./work"); system("rm -rf *");

// ==================== LOAD MODELS ====================
print("Load ThermoLib and Plant\n");

ThermoLib := getEnvironmentVar("THERMOS") + "/package.mo";
for f in {ThermoLib, "../plant.mo"} loop
  if loadFile(f) then
    print(f + " loaded successfully\n");
  else
    print("Failed to load: " + f + "\n");
    print(getErrorString() + "\n");
    exit(1);
  end if;
end for;

// ==================== SAVE FLATTENED MODEL ====================
print("Save Flattened Model (total.mo)\n");
res := saveTotalModelDebug("total.mo", plant);
if not res then
  print("saveTotalModel failed\n") ; 
  print(getErrorString()+"\n");
end if;
//dumpXMLDAE("plant_dae.xml", plant);

// ==================== SIMULATION ====================
print("Simulate Plant");
flags := "-lv=LOG_LS,LOG_INIT,LOG_NLS -w";

simulate(plant, startTime=0, stopTime=tEnd, 
              outputFormat=resFormat, simflags=flags);
print(getErrorString()+"\n");

// ==================== READ SIMULATION RESULTS ====================
sVars := readSimulationResultVars(resFile);
if size(sVars,1) == 0 then
  print("No simulation variables found simulation may have failed\n");
else
  print("Simulation completed successfully. Variables count: " + String(size(sVars,1)) + "\n");
end if;


// Below works only for mat output files
if (resFormat == "mat") then
t:=1;
print("Plant Conditions at t=" + String(t) + "\n");
ans := ThermoS.Util.printVars(resFile, 
                          {"time", "delp.pump", "delp.valve", "delp.heater",
                           "pump.Vdot", "pump.Ws",
                           "pump.inlet.m_flow", "pump.inlet.p",
                           "pump.outlet.p", "valve.inlet.p",
                           "valve.outlet.p", "htr.inlet.p",
                           "htr.outlet.p","tank.Q_in","htr.Q_wf" 
                          },
                          t);
end if;

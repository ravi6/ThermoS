if not res then
  print("saveTotalModel failed\n") ; 
  print(getErrorString()+"\n");
end if;
dumpXMLDAE("plant_dae.xml", plant);
*/
// ==================== SIMULATION ====================
print("Simulate Plant");
flags := "-lv=LOG_LS,LOG_INIT,LOG_NLS -w";

simulate(plant, startTime=0, stopTime=tEnd, outputFormat="csv", simflags=flags);
checkStatus("simulate()");

// ==================== READ SIMULATION RESULTS ====================
sVars := readSimulationResultVars("plant_res.csv");
if size(sVars,1) == 0 then
  print("No simulation variables found simulation may have failed");
else
  print("Simulation completed successfully. Variables count: " + String(size(sVars,1)));
end if;



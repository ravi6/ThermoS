#Plot variables with gnuplot
data="work/plant_res.csv"
set datafile separator ","
xlabel = "time (s)"

set term qt 1
set grid

set multiplot layout 3,1

set nokey
set ylabel  "Tank T(C)"
plot data using (column("time")):(column("tank.T")-273) w l  lw 2 title ""

set ylabel "Tank P(bar)"
plot data using (column("time")):(column("tank.p")*1e-5) w l lw 2  title ""

set ylabel "Tank Out Flow (kg/s)"
plot data using (column("time")):(-column("tank.outlet.m_flow")) w l lw 2  title ""

unset multiplot

pause(-1)

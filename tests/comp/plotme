#Plot variables with gnuplot
data="work/plant_res.csv"
set datafile separator ","
xlabel = "time (s)"
set datafile columnheaders


set term qt 1
set grid

set multiplot layout 4,1
set xlabel "Time (s)"
set xtics norotate

set key
set ylabel  "T(C)"
plot data using (column("time")):(column("tank.T")-273) w l  lw 2 title "Tank T",\
 data using (column("time")):(column("comp.Tout")-273) w l  lw 2 title "Comp Tout"


set ylabel "P(bar)"
plot data using (column("time")):(column("tank.p")*1e-5) w l lw 2  title "Tank P",\
 data using (column("time")):(column("comp.outlet.p")*1e-5) w l lw 2  title "Comp P"

set ylabel "Pratio"
plot data using (column("time")):(column("vin.inlet.p")*1e-5) with lines linewidth 2 title ""

set ylabel "Flow(lpm)"
set key
plot data using (column("time")):(column("vout.inlet.m_flow")*60e+3) w l lw 2  title "outFlow", \
     data using (column("time")):(column("tank.inlet.m_flow")*60e+3) w l lw 2  title "Tankin", \
     data using (column("time")):(column("comp.inlet.m_flow")*60e+3) w l lw 2  title "Cmpin"

unset multiplot
pause(-1)

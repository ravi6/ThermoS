#Plot variables with gnuplot
data="work/plant_res.csv"
set datafile separator ","
xlabel = "time (s)"

set term qt 1
set grid

set multiplot layout 3,1

set nokey
set ylabel  "mflow"
plot data using (column("time")):(column("mflow")) w l  lw 2 title ""
set ylabel  "x"
plot data using (column("time")):(column("x")) w l  lw 2 title ""
set ylabel  "T"
plot data using (column("time")):(column("T")-273) w l  lw 2 title ""

unset multiplot

pause(-1)
